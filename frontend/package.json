{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cms:dev": "sanity dev",
    "cms:build": "sanity build sanity-dist",
    "cms:schema:validate": "sanity schemas validate --level error",
    "cms:typegen": "sanity schema extract --enforce-required-fields --path sanity/schema.json --force && sanity typegen generate",
    "cms:manifest": "node --no-warnings --experimental-strip-types scripts/cms/generate-migration-manifest.mjs",
    "cms:seed:demo": "sanity exec scripts/cms/seed-demo-content.ts --with-user-token --",
    "cms:deploy": "sanity deploy",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run cms:manifest && node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "smoke:commerce": "node scripts/smoke-commerce.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@next/third-parties": "16.3.1",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.0",
    "lenis": "^1.3.18",
    "lucide-react": "^0.563.0",
    "next": "16.3.1",
    "next-sanity": "13.3.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.20.0",
    "sharp": "0.35.3",
    "styled-components": "6.5.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "sanity": "6.10.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
