# Public site configuration
NEXT_PUBLIC_SITE_DOMAIN=https://alfabeauty.co.id

# Analytics identifiers. Keep blank until consent-aware loading is implemented.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Lead persistence. Server-only; never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notification email. Server-only.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=

# Legacy CSV endpoint credential. This endpoint is a release blocker and must
# be replaced with authenticated, authorized, audited export before production.
CSV_EXPORT_TOKEN=

# Planned CMS integration. Do not populate before the CMS ADR and paid-plan
# role requirements in docs/PROJECT_SOURCE_OF_TRUTH.md are approved.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
