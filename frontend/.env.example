# Public site configuration
NEXT_PUBLIC_SITE_DOMAIN=https://alfabeauty.co.id

# Analytics identifiers. Keep blank until consent-aware loading is implemented.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Lead persistence. Server-only; never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notification email. Server-only.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=

# Legacy CSV endpoint credential. This endpoint is a release blocker and must
# be replaced with authenticated, authorized, audited export before production.
CSV_EXPORT_TOKEN=

# Sanity public identifiers. These values are safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Content behavior: fallback keeps the checked-in demo catalog available;
# required fails closed when Sanity is unavailable or misconfigured.
SANITY_CONTENT_MODE=fallback

# Server-only Viewer token for published reads and authenticated draft previews.
# Keep it configured when the dataset or document access is not anonymous.
SANITY_API_READ_TOKEN=

# Server-only secret for signed Sanity webhooks. Use at least 32 random chars.
SANITY_REVALIDATE_SECRET=

# Separate Sanity Studio app. SANITY_STUDIO_ORIGIN is the deployed Studio
# origin allowed to frame the site, for example https://alfa.sanity.studio.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
SANITY_STUDIO_ORIGIN=http://localhost:3333
SANITY_STUDIO_HOSTNAME=

# Commerce modes: disabled, demo (no vendor calls), or sandbox (Supabase + Midtrans Sandbox).
COMMERCE_MODE=demo
COMMERCE_SECURITY_SECRET=

# Midtrans Sandbox only. Production credentials are rejected by application code.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
